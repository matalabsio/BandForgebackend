# =============================================================================
# BandForge API (backend) — production-grade .gitignore
# Python / FastAPI / Docker / Supabase / Railway
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & environment — NEVER commit real values
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
!.env.example
!.env*.example
!env.local.example
!railway.production.env.example

# Cloud / payment / TLS credential dumps
*credentials*.json
*service-account*.json
*firebase-adminsdk*.json
*.pem
*.key
*.p12
*.pfx
*.crt
!**/fixtures/**/*.pem
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
.envrc
.direnv/
*.keystore
google-services.json
GoogleService-Info.plist

# -----------------------------------------------------------------------------
# Virtual environments & Python version pin (local)
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
.python-version
.conda/
pip-wheel-metadata/

# -----------------------------------------------------------------------------
# Python bytecode & packaging
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# -----------------------------------------------------------------------------
# Testing, coverage, type checkers, linters
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.pyre/
.pyright/
.cache/

# -----------------------------------------------------------------------------
# Jupyter / notebooks
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# Local Supabase (Docker) — keep migrations/ + config.toml tracked
# Do NOT ignore supabase/migrations/ — those are schema history, not the DB.
# Live Postgres data lives in Docker volumes / hosted Supabase — never in git.
# -----------------------------------------------------------------------------
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/.env.*
supabase/db/
supabase/docker/
supabase/volumes/

# -----------------------------------------------------------------------------
# Local databases & dumps (never commit live data)
# -----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.sql.bak
*.dump
*.bak
dump.rdb
pgdata/
postgres-data/
docker/volumes/
**/docker-volumes/

# Private / one-off seeds with secrets (e.g. redeemable coupon codes)
seed/*.local.sql
seed/*_private.sql
seed/coupons_seed.sql

# -----------------------------------------------------------------------------
# Generated / local media (uploaded to object storage, never checked in)
# -----------------------------------------------------------------------------
audio_seed/
uploads/
media/
tmp_audio/
*.mp3
*.wav
*.webm
*.m4a
*.flac
*.ogg

# -----------------------------------------------------------------------------
# Logs & runtime
# -----------------------------------------------------------------------------
*.log
logs/
uvicorn.pid
*.pid
.celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# Local profiling / probe outputs (regenerable)
docs/*-probe.json
docs/*-probe*.json
**/route-timing*.json
**/probe-results*.json

# -----------------------------------------------------------------------------
# Docker / deploy local overrides
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/

# -----------------------------------------------------------------------------
# OS & editor
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# -----------------------------------------------------------------------------
# Local agent / tooling artifacts
# -----------------------------------------------------------------------------
.cursor/
.claude/
.agents/
.agent/
.codex/
.scratch/
tmp/
temp/
*.local
!*.example
!env.local.example

# -----------------------------------------------------------------------------
# Security scanners / accidental secret dumps
# -----------------------------------------------------------------------------
*.secret
*.secrets
secrets/
.secrets/
gitleaks-report.json
trufflehog-report.json
