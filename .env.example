# Copy to .env ONLY if backend/.env does not exist yet:
#   cp .env.example .env
# Never overwrite an existing .env — you will lose real keys.

# Supabase (Dashboard → Settings → API — project_ref must match .cursor/mcp.json)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Server-only: secret (sb_secret_…) or legacy service_role (eyJ…). NOT the publishable key.
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Cloudflare R2 (speaking audio)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bandforge-speaking-audio
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Auth (local dev defaults)
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:3000
AUTH_SKIP_EMAIL_VERIFY=true
PHONE_OTP_ENABLED=false

# Optional
API_HOST=0.0.0.0
API_PORT=8000
