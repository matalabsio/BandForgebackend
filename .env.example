# Copy to .env for local development (see README).

APP_ENV=development

# Supabase (service role — backend only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# JWT session cookies
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Frontend origin (CORS + email links)
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Admin allowlist (email/password login)
ADMIN_ALLOWED_EMAIL=product@matalabs.io

# Phone OTP (MSG91, India +91) — off by default
PHONE_OTP_ENABLED=false
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Email OTP (Resend) — off by default
EMAIL_OTP_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=BandForge <onboarding@resend.dev>

# Local OTP demo (never enable in production)
AUTH_DEMO_OTP=
AUTH_DEMO_OTP_ENABLED=true
AUTH_OPEN_OTP=false

# Skip email verification for local dev (guarded in production docs)
AUTH_SKIP_EMAIL_VERIFY=true

# Optional: Redis for distributed rate limits (production)
REDIS_URL=
