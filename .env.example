# BandForge backend — copy to .env and fill secrets.
# Local offline AI defaults (recommended for day-to-day development):

WRITING_EVAL_STUB=true
SPEAKING_EVAL_STUB=true
WRITING_LLM_PRIMARY=none
WRITING_LLM_FALLBACK=none
WRITING_PROMPT_VERSION=v5

# Live Claude validation only (intentional):
# WRITING_EVAL_STUB=false
# SPEAKING_EVAL_STUB=false
# WRITING_LLM_PRIMARY=claude
# WRITING_LLM_FALLBACK=groq
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_API_KEY=sk-ant-...          # alias of ANTHROPIC_API_KEY
# ANTHROPIC_PROVIDER=direct
# ANTHROPIC_MODEL=claude-sonnet-4-6
# WRITING_EVAL_TIMEOUT_SEC=120
# GROQ_API_KEY=gsk_...
# After changing ANTHROPIC_MODEL or WRITING_PROMPT_VERSION, re-run:
#   python scripts/evaluate_fixture.py --all --live --calibrate --no-cache

# Phase 3 — AI ops (local-friendly defaults; raise for production)
CLAUDE_DAILY_LIMIT=20
CLAUDE_MONTHLY_LIMIT=100
CLAUDE_WARNING_AT=16
AI_CIRCUIT_FAIL_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SEC=300
AI_BUDGET_FALLBACK_STUB=true
AI_INPUT_USD_PER_MTOK=3.0
AI_OUTPUT_USD_PER_MTOK=15.0

# Required
# SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-service-role-key

# Speaking release notifications (outbox worker is a separate Railway service)
# RESEND_API_KEY=re_...
# EMAIL_FROM=BandForge <reports@example.com>
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_LEASE_SECONDS=120
NOTIFICATION_WORKER_POLL_SECONDS=2
# META_WHATSAPP_ENABLED=false
# META_WHATSAPP_GRAPH_VERSION=v23.0
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_TEMPLATE_NAME=speaking_report_ready
# META_WHATSAPP_TEMPLATE_LANGUAGE=en
# META_WHATSAPP_VERIFY_TOKEN=
# META_WHATSAPP_APP_SECRET=
# If META_WHATSAPP_ENABLED=true in production, every META_* value above is required.

APP_ENV=development
JWT_SECRET=dev-change-me-bandforge-jwt-secret
JWT_REFRESH_SECRET=dev-change-me-bandforge-refresh-secret
FRONTEND_URL=http://localhost:3000
AUTH_SKIP_EMAIL_VERIFY=true
ADMIN_ALLOWED_EMAIL=

# Railway production (bandforge-api service — NOT the Vercel frontend)
# APP_ENV=production
# API_HOST=0.0.0.0
# Do NOT set API_PORT unless you also set the domain Target Port to the same value.
# Clear Target Port on the public domain so Railway routes to $PORT automatically.
# FRONTEND_URL=https://bandforge-web.vercel.app
# CORS_ORIGINS=https://bandforge-web.vercel.app
# GOOGLE_REDIRECT_URI=https://bandforge-web.vercel.app/api/auth/google/callback

# Razorpay (Test mode locally — never commit live keys)
# RAZORPAY_ENABLED=true
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# Dashboard → Payment Configuration → Configuration ID (UPI Apps+QR first)
# RAZORPAY_CHECKOUT_CONFIG_ID=config_...
# Wire helper: PYTHONPATH=. .venv/bin/python scripts/wire_razorpay_checkout_config.py config_XXX

# ASR / speaking (optional when SPEAKING_EVAL_STUB=true)
ASR_PROVIDER=groq
LLM_PROVIDER=claude
SPEAKING_LLM_FALLBACK=groq
