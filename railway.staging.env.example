# Railway staging API — bandforge-api (staging service)
# Copy into Railway → Variables for the STAGING service only.
# Never point these at production Supabase / live Razorpay.
# See docs/staging-environment.md

APP_ENV=staging

# --- Supabase (staging project only — NOT nkwtxkhtsclyakympbno) ---
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# --- Auth / sessions (unique staging secrets; do not reuse production) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Staging frontend origins ---
FRONTEND_URL=https://YOUR_STAGING_FRONTEND_HOST
CORS_ORIGINS=https://YOUR_STAGING_FRONTEND_HOST
GOOGLE_REDIRECT_URI=https://YOUR_STAGING_FRONTEND_HOST/api/auth/google/callback
# Optional public API origin (must NOT be backend-production-a813.up.railway.app)
# PUBLIC_API_URL=https://YOUR_STAGING_API_HOST

# --- Cache (prefer a dedicated Upstash/Redis; optional for light QA) ---
REDIS_URL=

# --- Razorpay TEST mode only (rzp_test_*) ---
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL:
#   https://YOUR_STAGING_API_HOST/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=
# Optional Checkout config id (test mode)
# RAZORPAY_CHECKOUT_CONFIG_ID=

# --- Google OAuth (staging redirect URI must be registered) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Staging may keep stubs off for realistic Dual E2E; adjust as needed.
WRITING_EVAL_STUB=false
SPEAKING_EVAL_STUB=false
AUTH_DEMO_OTP_ENABLED=false
AUTH_OPEN_OTP=false
AUTH_SKIP_EMAIL_VERIFY=false

# Also set on Railway when needed: ANTHROPIC_API_KEY / CLAUDE_API_KEY, GROQ_API_KEY, R2_*
#
# Startup refuses:
#   APP_ENV=staging + production Supabase project ref
#   APP_ENV=staging + rzp_live_* keys
#   APP_ENV=staging + production FRONTEND_URL / GOOGLE_REDIRECT_URI
#
# Verify after deploy:
#   GET /api/status → environment=staging
#   GET /health
