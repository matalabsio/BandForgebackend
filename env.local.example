# Copy is optional — ./scripts/local_supabase.sh start writes .env.local automatically.
#
# Manual template (after `supabase start`):
#   SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SECRET_KEY=<from: supabase status>
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from: supabase status>

SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-service-role-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-key
SUPABASE_LOCAL=true
