# Copy to backend/.env.local for local auth refresh testing (gitignored).
# Overrides backend/.env in development only (see app/config.py).

ACCESS_TOKEN_EXPIRE_MINUTES=1
REFRESH_TOKEN_EXPIRE_DAYS=30

# Restore production-like access TTL after testing:
# ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- Razorpay payments (test mode first) ---
# Enable the payments module. Leave false until keys are set.
RAZORPAY_ENABLED=false
# Test keys from Razorpay dashboard (rzp_test_...). Switch to live only after review.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret configured in Razorpay dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET=
