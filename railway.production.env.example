# Railway production API — required variables (bandforge-api service)
# Copy values into Railway → Variables. Never commit secrets.

APP_ENV=production
FRONTEND_URL=https://bandforgeuinew.vercel.app
CORS_ORIGINS=https://bandforgeuinew.vercel.app,https://frontend-chi-ebon-lxy95up4j4.vercel.app
GOOGLE_REDIRECT_URI=https://bandforgeuinew.vercel.app/api/auth/google/callback

# AI evaluation — production-grade (no stubs, fail loud on budget exhaustion)
WRITING_EVAL_STUB=false
SPEAKING_EVAL_STUB=false
WRITING_LLM_PRIMARY=claude
WRITING_LLM_FALLBACK=groq
LLM_PROVIDER=claude
SPEAKING_LLM_FALLBACK=groq
ASR_PROVIDER=groq
AI_BUDGET_FALLBACK_STUB=false
GROQ_MODEL=openai/gpt-oss-120b

# Set ANTHROPIC_API_KEY or CLAUDE_API_KEY, GROQ_API_KEY, REDIS_URL, R2_*, SUPABASE_* on Railway.
# Verify after deploy:
#   GET /api/status → environment=production
#   GET /api/admin/ai/health (admin auth) → claude_configured, groq_configured, writing_eval_stub=false
