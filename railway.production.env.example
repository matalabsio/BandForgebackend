# =============================================================================
# BandForgebackend — Railway PRODUCTION variables
# =============================================================================
# How to use:
#   1. Copy this into Railway → Variables → Raw Editor (or set one-by-one).
#   2. Replace every REPLACE_ME / YOUR_* value with real secrets.
#   3. Do NOT paste backend/.env (local/dev) as-is — production refuses it.
#   4. Public networking Target Port must be 8080.
#
# MUST DELETE on Railway (do not set at all):
#   AUTH_DEMO_OTP
#
# After deploy:
#   curl -sS https://bandforgebackend-production.up.railway.app/health
#   curl -sS https://bandforgebackend-production.up.railway.app/api/status
# =============================================================================

# --- Core (required for boot) ------------------------------------------------
APP_ENV=production
PORT=8080
PUBLIC_API_URL=https://bandforgebackend-production-5ec9.up.railway.app

FRONTEND_URL=https://bandforgeuinew.vercel.app
ADMIN_URL=https://admin-rose-eight-52.vercel.app
CORS_ORIGINS=https://bandforgeuinew.vercel.app,https://admin-rose-eight-52.vercel.app,https://frontend-chi-ebon-lxy95up4j4.vercel.app

# Generate with: openssl rand -hex 32  (must be ≥32 chars, not dev-change-me-*)
JWT_SECRET=REPLACE_ME_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=REPLACE_ME_OPENSSL_RAND_HEX_32_DIFFERENT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Auth / email (production-safe) ------------------------------------------
AUTH_SKIP_EMAIL_VERIFY=false
AUTH_DEMO_OTP_ENABLED=false
AUTH_OPEN_OTP=false
# Do NOT set AUTH_DEMO_OTP at all.

PHONE_OTP_ENABLED=false
EMAIL_OTP_ENABLED=false

RESEND_API_KEY=REPLACE_ME_re_xxx
# Must be a Resend-verified domain — NEVER onboarding@resend.dev
EMAIL_FROM=BandForge <noreply@YOUR_VERIFIED_DOMAIN>

ADMIN_ALLOWED_EMAIL=product@matalabs.io

GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=https://bandforgeuinew.vercel.app/api/auth/google/callback

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://nkwtxkhtsclyakympbno.supabase.co
SUPABASE_SECRET_KEY=REPLACE_ME_sb_secret_xxx
# Optional (if your deploy reads them):
# NEXT_PUBLIC_SUPABASE_URL=https://nkwtxkhtsclyakympbno.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_ME

# --- Redis (Upstash) ---------------------------------------------------------
REDIS_URL=REPLACE_ME_rediss://default:TOKEN@HOST.upstash.io:6379
# UPSTASH_REDIS_REST_URL=REPLACE_ME
# UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# --- R2 (speaking audio) -----------------------------------------------------
R2_ACCOUNT_ID=REPLACE_ME
R2_ACCESS_KEY_ID=REPLACE_ME
R2_SECRET_ACCESS_KEY=REPLACE_ME
R2_BUCKET_NAME=bandforge-speaking-audio
R2_ENDPOINT_URL=REPLACE_ME

# --- Razorpay ----------------------------------------------------------------
# Prefer live keys + webhook secret in real production.
# Test keys boot, but webhook secret is recommended.
RAZORPAY_ENABLED=true
RAZORPAY_KEY_ID=REPLACE_ME_rzp_live_or_test
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME
# RAZORPAY_CHECKOUT_CONFIG_ID=

# --- AI (Anthropic + Groq) ---------------------------------------------------
ANTHROPIC_PROVIDER=direct
ANTHROPIC_MODEL=claude-sonnet-4-6
CLAUDE_API_KEY=REPLACE_ME_sk_ant_xxx
ANTHROPIC_API_KEY=REPLACE_ME_sk_ant_xxx
GROQ_API_KEY=REPLACE_ME_gsk_xxx
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_MODEL=openai/gpt-oss-120b

WRITING_PROMPT_VERSION=v5
WRITING_EVAL_STUB=false
SPEAKING_EVAL_STUB=false
WRITING_LLM_PRIMARY=claude
WRITING_LLM_FALLBACK=groq
LLM_PROVIDER=claude
SPEAKING_LLM_FALLBACK=groq
ASR_PROVIDER=groq
AI_BUDGET_FALLBACK_STUB=false
CLAUDE_DAILY_LIMIT=200
CLAUDE_MONTHLY_LIMIT=2000
CLAUDE_WARNING_AT=160

# Production: keep exam order locked (0). Local .env often uses 1 for testing.
MOCK_FREE_MODULE_ACCESS=0

# --- Cloudflare Stream (optional) --------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=REPLACE_ME
# CLOUDFLARE_API_TOKEN=REPLACE_ME
# STREAM_CUSTOMER_CODE=REPLACE_ME
# STREAM_SIGNING_KEY_ID=
# STREAM_SIGNING_KEY_JWK=
# STREAM_TOKEN_TTL_SECONDS=3600
# PRACTICE_LOCK_PUBLIC_VIDEOS=true

# --- Optional integrations ---------------------------------------------------
# GOOGLE_SHEETS_WEBHOOK_URL=
# GOOGLE_SHEETS_WEBHOOK_SECRET=
# OPENAI_API_KEY=
